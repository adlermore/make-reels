{
  "name": "make-reels",
  "version": "0.1.0",
  "private": true,
  "description": "AI Reels Production Studio — Remotion video engine + provider adapters + Claude Code agents",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "reel": "node --disable-warning=ExperimentalWarning --import tsx pipeline/cli.ts",
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test tests/*.test.ts",
    "setup:voice": "node scripts/setup-voice.mjs",
    "doctor": "npm run reel -- doctor",
    "lint:hy-strings": "node --disable-warning=ExperimentalWarning --import tsx scripts/lint-hy-strings.ts",
    "bootstrap": "node scripts/bootstrap.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.540",
    "@remotion/captions": "4.0.540",
    "@remotion/cli": "4.0.540",
    "@remotion/google-fonts": "4.0.540",
    "@remotion/media-utils": "4.0.540",
    "@remotion/renderer": "4.0.540",
    "@remotion/transitions": "4.0.540",
    "dotenv": "18.0.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.540",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
